generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  ADMIN
  FARM_MANAGER
  AGRONOMIST
  OPERATOR
}

enum CropStatus {
  ACTIVE
  HARVESTED
  INACTIVE
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum VegetationSource {
  SATELLITE
  DRONE
  UAV
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Estado de ejecución de una recomendación, independiente de su prioridad.
enum RecommendationStatus {
  PENDING
  IN_PROGRESS
  APPLIED
  DISMISSED
}

// USERS

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  farms                 Farm[]
  fieldNotebookEntries  FieldNotebookEntry[]
  reportsCreated        Report[]

  @@map("users")
}


// FARMS

model Farm {
  id                     Int      @id @default(autoincrement())
  ownerId                Int
  name                   String
  location               String
  totalAreaSquareMeters  Decimal  @db.Decimal(12, 2)
  createdAt              DateTime @default(now())

  owner  User    @relation(fields: [ownerId], references: [id])
  fields Field[]

  @@index([ownerId])
  @@map("farms")
}


// FIELDS

model Field {
  id                Int      @id @default(autoincrement())
  farmId            Int
  name              String
  areaSquareMeters  Decimal  @db.Decimal(12, 2)
  soilType          String
  irrigationType    String
  status            String
  createdAt         DateTime @default(now())

  farm                  Farm                    @relation(fields: [farmId], references: [id])
  crops                 Crop[]
  sensors               Sensor[]
  telemetryReadings     TelemetryReading[]
  visionInspections     VisionInspection[]
  vegetationSnapshots   VegetationSnapshot[]
  evidenceItems         EvidenceItem[]
  zoneInsights          ZoneInsight[]
  alerts                Alert[]
  recommendations       Recommendation[]
  notebookEntries       FieldNotebookEntry[]
  reports               Report[]

  @@index([farmId])
  @@map("fields")
}


// CROP PROFILES
model CropProfile {
  id                      Int      @id @default(autoincrement())

  // Cada código identifica un único perfil del catálogo persistido.
  cropType                String   @unique
  displayName             String
  scientificName          String?

  // Las listas y objetos conservan la estructura JSONB definida por la migración.
  // Los servicios consumidores deben validar el contenido de estos documentos.
  analysisFocus           Json     @default("[]") @db.JsonB
  mainRisks               Json     @default("[]") @db.JsonB
  riskRules               Json     @default("{}") @db.JsonB
  preferredMetrics        Json     @default("[]") @db.JsonB
  recommendationTemplates Json     @default("{}") @db.JsonB

  createdAt               DateTime @default(now())

  // Cultivos asociados con este perfil del catálogo.
  crops Crop[]

  @@map("crop_profiles")
}

// CROPS

model Crop {
  id            Int      @id @default(autoincrement())
  fieldId       Int
  cropProfileId Int
  cropType      String
  name          String
  growthStage   String
  plantedAt     DateTime
  status        CropStatus

  field       Field      @relation(fields: [fieldId], references: [id])
  cropProfile CropProfile @relation(fields: [cropProfileId], references: [id])

  visionInspections    VisionInspection[]
  zoneInsights         ZoneInsight[]
  notebookEntries      FieldNotebookEntry[]

  @@index([fieldId])
  @@index([cropProfileId])
  @@map("crops")
}


// SENSORS

model Sensor {
  id          Int      @id @default(autoincrement())
  fieldId     Int
  type        String
  name        String
  status      SensorStatus
  installedAt DateTime

  field             Field              @relation(fields: [fieldId], references: [id])
  telemetryReadings TelemetryReading[]

  @@index([fieldId])
  @@map("sensors")
}


// TELEMETRY READINGS

model TelemetryReading {
  id         Int      @id @default(autoincrement())
  sensorId   Int
  fieldId    Int
  metric     String
  value      Decimal  @db.Decimal(12, 4)
  unit       String
  quality    String?
  recordedAt DateTime

  sensor Sensor @relation(fields: [sensorId], references: [id])
  field  Field  @relation(fields: [fieldId], references: [id])

  @@index([sensorId])
  @@index([fieldId])
  @@index([recordedAt])
  @@map("telemetry_readings")
}


// VISION INSPECTIONS

model VisionInspection {
  id                      Int      @id @default(autoincrement())
  fieldId                 Int
  zoneId                  String
  cropId                  Int

  // Código de cultivo registrado junto con el resultado de la inspección.
  cropType                String   @default("GENERAL")

  prediction              String
  confidence              Decimal  @db.Decimal(5, 4)
  greenCoveragePercentage Decimal  @db.Decimal(5, 2)
  dryAreaPercentage       Decimal  @db.Decimal(5, 2)

  // Indicadores visuales asociados con el resultado almacenado.
  chlorosisSuspected      Boolean  @default(false)
  leafSpotSuspected       Boolean  @default(false)
  stressPatternDetected   Boolean  @default(false)

  recommendedAction       String?

  // Evidencia estructurada y nombre del archivo asociado con la inspección.
  evidence                Json?    @db.JsonB
  imageFileName           String?

  explanation             String?
  createdAt               DateTime @default(now())

  // Relaciones con la parcela y el cultivo inspeccionado.
  field Field @relation(fields: [fieldId], references: [id])
  crop  Crop  @relation(fields: [cropId], references: [id])

  @@index([fieldId])
  @@index([cropId])
  @@index([zoneId])
  @@map("vision_inspections")
}

// Registro append-only del contrato completo de inferencia. No sustituye las inspecciones agronómicas existentes.
model VisionAnalysisRecord {
  inspectionId  String   @id
  fieldId       String
  zoneId        String?
  cropType      String
  imageFileName String
  imageSha256   String
  result        Json
  createdAt     DateTime

  // La relaciÃ³n es opcional para conservar anÃ¡lisis anteriores sin fotografÃ­a archivada.
  image VisionAnalysisImage?

  @@index([createdAt])
  @@index([cropType, createdAt])
  @@map("vision_analysis_records")
}

// Archivo binario original asociado uno a uno con un anÃ¡lisis Vision confirmado.
model VisionAnalysisImage {
  inspectionId String   @id
  content      Bytes
  mimeType     String
  sizeBytes    Int
  archivedAt   DateTime @default(now())

  analysis VisionAnalysisRecord @relation(fields: [inspectionId], references: [inspectionId], onDelete: Cascade)

  @@map("vision_analysis_images")
}


// VEGETATION SNAPSHOTS

model VegetationSnapshot {
  id              Int      @id @default(autoincrement())
  fieldId         Int
  zoneId          String
  source          VegetationSource
  ndvi            Decimal? @db.Decimal(8, 4)
  ndwi            Decimal? @db.Decimal(8, 4)
  gndvi           Decimal? @db.Decimal(8, 4)
  vigorLevel      String
  anomalyDetected Boolean  @default(false)
  capturedAt      DateTime

  field Field @relation(fields: [fieldId], references: [id])

  @@index([fieldId])
  @@index([zoneId])
  @@index([capturedAt])
  @@map("vegetation_snapshots")
}


// EVIDENCE ITEMS

model EvidenceItem {
  id          Int      @id @default(autoincrement())
  fieldId     Int
  zoneId      String
  source      String
  metric      String
  value       Decimal  @db.Decimal(12, 4)
  unit        String
  status      String
  explanation String?
  createdAt   DateTime @default(now())

  field Field @relation(fields: [fieldId], references: [id])

  @@index([fieldId])
  @@index([zoneId])
  @@map("evidence_items")
}


// ZONE INSIGHTS

model ZoneInsight {
  id               Int      @id @default(autoincrement())
  fieldId          Int
  zoneId           String
  cropId           Int
  finalRiskLevel   RiskLevel
  healthScore      Decimal  @db.Decimal(5, 2)
  mainCause        String?
  summary          String?
  recommendedAction String?
  generatedAt      DateTime @default(now())

  field Field @relation(fields: [fieldId], references: [id])
  crop  Crop  @relation(fields: [cropId], references: [id])

  alerts          Alert[]
  recommendations Recommendation[]
  reports         Report[]

  @@index([fieldId])
  @@index([cropId])
  @@index([zoneId])
  @@index([finalRiskLevel])
  @@map("zone_insights")
}


// ALERTS

model Alert {
  id                Int       @id @default(autoincrement())
  fieldId           Int
  zoneId            String
  zoneInsightId     Int
  type              String
  severity          AlertSeverity
  title             String
  message           String
  recommendedAction String?
  status             AlertStatus
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  field       Field       @relation(fields: [fieldId], references: [id])
  zoneInsight ZoneInsight @relation(fields: [zoneInsightId], references: [id])

  @@index([fieldId])
  @@index([zoneId])
  @@index([zoneInsightId])
  @@index([status])
  @@map("alerts")
}


// RECOMMENDATIONS

model Recommendation {
  id                        Int                    @id @default(autoincrement())
  fieldId                   Int
  zoneId                    String
  zoneInsightId             Int
  priority                  RecommendationPriority

  // El seguimiento operativo conserva su estado y el tipo de acción propuesta.
  status                    RecommendationStatus   @default(PENDING)
  actionType                String                 @default("MONITORING")

  reason                    String?
  suggestedAction           String

  // La dosificación y el plazo son opcionales según la acción registrada.
  dosageValue               Decimal?               @db.Decimal(12, 2)
  dosageUnit                String?
  timeframe                 String?

  // Descripción y alcance del impacto esperado.
  expectedImpactType        String?
  expectedImpactArea        Decimal?               @db.Decimal(12, 2)
  expectedImpactDescription String?

  createdAt                 DateTime               @default(now())

  // Relaciones con la parcela y el análisis que origina la recomendación.
  field       Field       @relation(fields: [fieldId], references: [id])
  zoneInsight ZoneInsight @relation(fields: [zoneInsightId], references: [id])

  @@index([fieldId])
  @@index([zoneId])
  @@index([zoneInsightId])
  @@index([priority])
  @@map("recommendations")
}

// FIELD NOTEBOOK ENTRIES

model FieldNotebookEntry {
  id                Int      @id @default(autoincrement())
  fieldId           Int
  zoneId            String
  cropId            Int
  activityType      String
  description       String?
  problemObserved   String?
  actionTaken       String?
  responsibleUserId Int

  // Fecha de seguimiento y evidencia estructurada de la actividad registrada.
  followUpAt        DateTime?
  evidence          Json?    @db.JsonB

  createdAt         DateTime @default(now())

  // Relaciones con la parcela, el cultivo y la persona responsable.
  field           Field @relation(fields: [fieldId], references: [id])
  crop            Crop  @relation(fields: [cropId], references: [id])
  responsibleUser User  @relation(fields: [responsibleUserId], references: [id])

  @@index([fieldId])
  @@index([cropId])
  @@index([responsibleUserId])
  @@index([zoneId])
  @@map("field_notebook_entries")
}


// REPORTS

model DemoRequest {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @db.VarChar(254)
  organization String?  @db.VarChar(150)
  message      String   @db.VarChar(2000)
  consentAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("demo_requests")
}

model Report {
  id            Int      @id @default(autoincrement())
  fieldId       Int
  zoneId        String
  zoneInsightId Int
  title         String
  summary       String?
  riskLevel     RiskLevel
  createdBy     Int
  createdAt     DateTime @default(now())

  field       Field       @relation(fields: [fieldId], references: [id])
  zoneInsight ZoneInsight @relation(fields: [zoneInsightId], references: [id])
  creator     User        @relation(fields: [createdBy], references: [id])

  @@index([fieldId])
  @@index([zoneId])
  @@index([zoneInsightId])
  @@index([createdBy])
  @@map("reports")
}
